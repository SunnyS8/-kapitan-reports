# Railway Environment Variables
# PORT — автоматически устанавливается Railway
# DATA_DIR — каталог Persistent Volume для загруженных и сформированных файлов
DATA_DIR=/app/data
# BASE_KNOWLEDGE — путь к Persistent Volume, смонтированному в Railway
BASE_KNOWLEDGE=/app/data
# INTERNAL_CLIENTS — внутренние контрагенты, исключаются из общих продаж
# и помечаются отдельной строкой. Разделитель — точка с запятой.
# Это данные конкретной компании, поэтому задаются здесь, а не в коде.
# Если переменная не задана — внутренних контрагентов нет.
# Пример: INTERNAL_CLIENTS="ООО Ромашка;ООО Вектор"
INTERNAL_CLIENTS=
# INTERNAL_CLIENT_TAG — подпись для таких строк в отчётах
INTERNAL_CLIENT_TAG=ВНУТР (НДС)
# HERMES_EXE — необязательно; AI-режим требует установленного Hermes в контейнере
